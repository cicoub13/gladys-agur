{
  "manifest_version": 1,
  "type": "device",
  "name": "Agur",
  "description": {
    "en": "Follow your Agur water meter: index, consumption, invoices and amount due.",
    "fr": "Suivez votre compteur d'eau Agur : index, consommation, factures et reste à payer."
  },
  "version": "0.1.2",
  "docker_image": "ghcr.io/cicoub13/gladys-agur:0.1.2",
  "gladys_version": ">=4.86.0",
  "cover_image": "https://raw.githubusercontent.com/cicoub13/gladys-agur/main/cover.png",
  "categories": ["energy", "services"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect your water account",
        "fr": "Connexion à votre compte eau"
      },
      "description": {
        "en": "Use the email and password you log in with on the Agur customer website. Each contract of the account then shows up in the Discovery tab.",
        "fr": "Utilisez l'adresse e-mail et le mot de passe avec lesquels vous vous connectez à l'espace client Agur. Chaque contrat du compte apparaît ensuite dans l'onglet Découverte."
      },
      "links": [
        {
          "url": "https://ael.agur.fr",
          "label": {
            "en": "Agur customer website",
            "fr": "Espace client Agur"
          }
        }
      ]
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "Email",
        "fr": "Adresse e-mail"
      },
      "required": true
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe"
      },
      "required": true
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion"
      },
      "timeout_seconds": 60
    }
  ]
}
